# Keep text files on LF line endings in the repo AND in working copies, on every OS.
# (Windows Git would otherwise convert to CRLF, which then fails format checks on Linux.)
* text=auto
*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh   text eol=lf

*.png  binary
*.ico  binary
